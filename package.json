{
  "name": "property-report-saas",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "prepare:engine": "node scripts/prepare-engine.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/prepare-engine.mjs && vite build && node scripts/build-server-renderer.mjs && node scripts/build-service-worker.mjs",
    "dev": "wrangler dev",
    "types": "wrangler types",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "release:check": "node scripts/release-check.mjs",
    "typecheck": "tsc --noEmit",
    "test:runtime": "node scripts/runtime-check.mjs",
    "licenses": "node scripts/dependency-inventory.mjs"
  },
  "dependencies": {
    "heic-to": "1.5.2",
    "jspdf": "4.2.1",
    "lucide-react": "1.66.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stripe": "23.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261101.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.156.0",
    "miniflare": "5.20261023.3-beta"
  }
}
